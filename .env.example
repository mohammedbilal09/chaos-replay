# ChaosReplay Local Development Environment Variables
# Copy this file to .env to override defaults if desired:
# cp .env.example .env

POSTGRES_DB=chaosreplay
POSTGRES_USER=chaosreplay
POSTGRES_PASSWORD=chaosreplay
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# JVM options for containerized application
JAVA_OPTS=-XX:+UseG1GC -XX:MaxRAMPercentage=75.0

